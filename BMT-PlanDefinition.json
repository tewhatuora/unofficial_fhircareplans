{
  "resourceType": "PlanDefinition",
  "id": "waiting-list-careplan",
  "url": "http://example.org/PlanDefinition/waiting-list-careplan",
  "version": "1.0.0",
  "name": "WaitingListCareplan",
  "title": "Waiting List Care Plan",
  "status": "active",
  "description": "Care plan workflow covering waiting list entry, iterative updates and treatment planning, and finalisation or cancellation.",

  "action": [

    {
      "id": "action-add-to-waiting-list",
      "title": "Add to Waiting List",
      "description": "Creates the care plan. Must be completed exactly once before any other action.",
      "requiredBehavior": "must",
      "cardinalityBehavior": "single",
      "definitionCanonical": "{{PLACEHOLDER_QUESTIONNAIRE_URI_ADD_TO_WAITING_LIST}}"
    },

    {
      "id": "action-update-waiting-list",
      "title": "Update Waiting List",
      "description": "Updates the waiting list entry. Repeatable. Completing this form with answer 'cancel' triggers care plan closure.",
      "requiredBehavior": "could",
      "cardinalityBehavior": "multiple",
      "relatedAction": [
        {
          "actionId": "action-add-to-waiting-list",
          "relationship": "after-end"
        }
      ],
      "condition": [
        {
          "kind": "applicability",
          "expression": {
            "language": "text/fhirpath",
            "expression": "%careplan.status = 'active'"
          }
        }
      ],
      "definitionCanonical": "{{PLACEHOLDER_QUESTIONNAIRE_URI_UPDATE_WAITING_LIST}}"
    },

    {
      "id": "action-treatment-planning",
      "title": "Treatment Planning",
      "description": "Records treatment planning information. Repeatable.",
      "requiredBehavior": "could",
      "cardinalityBehavior": "multiple",
      "relatedAction": [
        {
          "actionId": "action-add-to-waiting-list",
          "relationship": "after-end"
        }
      ],
      "condition": [
        {
          "kind": "applicability",
          "expression": {
            "language": "text/fhirpath",
            "expression": "%careplan.status = 'active'"
          }
        }
      ],
      "definitionCanonical": "{{PLACEHOLDER_QUESTIONNAIRE_URI_TREATMENT_PLANNING}}"
    },

    {
      "id": "action-treatment-plan-finalisation",
      "title": "Treatment Plan Finalisation",
      "description": "Finalises the treatment plan. Completing this form closes the care plan (status → completed).",
      "requiredBehavior": "could",
      "cardinalityBehavior": "single",
      "relatedAction": [
        {
          "actionId": "action-add-to-waiting-list",
          "relationship": "after-end"
        }
      ],
      "condition": [
        {
          "kind": "applicability",
          "expression": {
            "language": "text/fhirpath",
            "expression": "%careplan.status = 'active'"
          }
        }
      ],
      "definitionCanonical": "{{PLACEHOLDER_QUESTIONNAIRE_URI_TREATMENT_PLAN_FINALISATION}}"
    },

    {
      "id": "action-close-careplan-on-finalisation",
      "title": "Close Care Plan — Finalised",
      "description": "Transitions the care plan to 'completed' once Treatment Plan Finalisation is submitted.",
      "requiredBehavior": "must",
      "cardinalityBehavior": "single",
      "relatedAction": [
        {
          "actionId": "action-treatment-plan-finalisation",
          "relationship": "after-end"
        }
      ],
      "condition": [
        {
          "kind": "start",
          "expression": {
            "language": "text/fhirpath",
            "expression": "%action[action-treatment-plan-finalisation].status = 'completed'"
          }
        }
      ],
      "dynamicValue": [
        {
          "path": "status",
          "expression": {
            "language": "text/fhirpath",
            "expression": "'completed'"
          }
        }
      ]
    },

    {
      "id": "action-close-careplan-on-cancel",
      "title": "Close Care Plan — Cancelled",
      "description": "Transitions the care plan to 'revoked' when an Update Waiting List form is submitted with the answer 'cancel'.",
      "requiredBehavior": "must",
      "cardinalityBehavior": "single",
      "relatedAction": [
        {
          "actionId": "action-update-waiting-list",
          "relationship": "after-end"
        }
      ],
      "condition": [
        {
          "kind": "start",
          "expression": {
            "language": "text/fhirpath",
            "expression": "%action[action-update-waiting-list].output.item.where(linkId = '{{PLACEHOLDER_CANCEL_QUESTION_LINKID}}').answer.value = 'cancel'"
          }
        }
      ],
      "dynamicValue": [
        {
          "path": "status",
          "expression": {
            "language": "text/fhirpath",
            "expression": "'revoked'"
          }
        }
      ]
    }

  ]
}
